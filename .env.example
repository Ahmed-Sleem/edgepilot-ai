# EdgePilot AI - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/edgepilot"

# =============================================================================
# AI PROVIDERS (SERVER-ONLY - NEVER expose to client)
# =============================================================================

# Ollama (Local AI)
OLLAMA_HOST="http://localhost:11434"

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key-here"

# Groq
GROQ_API_KEY="your-groq-api-key-here"

# OpenAI (optional)
OPENAI_API_KEY="your-openai-api-key-here"

# =============================================================================
# AUTHENTICATION
# =============================================================================

# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (optional)
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# =============================================================================
# RATE LIMITING (optional)
# =============================================================================

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# =============================================================================
# MONITORING (optional)
# =============================================================================

# Sentry (error tracking)
SENTRY_DSN="your-sentry-dsn"

# =============================================================================
# PUBLIC VARIABLES (safe to expose to client)
# =============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 
# 1. NEVER commit .env.local to version control
# 2. NEVER use NEXT_PUBLIC_ prefix for secrets
# 3. API keys MUST stay server-side only
# 4. Use .env.example as a template
#
# For more information, see docs/security.md
